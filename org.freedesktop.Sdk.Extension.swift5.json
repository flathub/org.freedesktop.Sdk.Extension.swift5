{
    "id": "org.freedesktop.Sdk.Extension.swift5",
    "branch": "23.08",
    "runtime": "org.freedesktop.Sdk",
    "build-extension": true,
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.llvm16"
    ],
    "runtime-version": "23.08",
    "separate-locales": false,
    "build-options": {
        "prefix": "/usr/lib/sdk/swift5",
        "prepend-pkg-config-path": "/usr/lib/sdk/swift5/lib/pkgconfig/"
    },
    "cleanup": [
        "/share/info",
        "/share/man"
    ],
    "modules": [
        {
            "name": "swift",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "only-arches": ["x86_64"],
                    "url": "https://download.swift.org/swift-5.10.1-release/amazonlinux2/swift-5.10.1-RELEASE/swift-5.10.1-RELEASE-amazonlinux2.tar.gz",
                    "sha256": "2a430fde80c558875507808d9bfcb1afe39effaa683c14b3c72d6b84380de267"
                },
                {
                    "type": "archive",
                    "only-arches": ["aarch64"],
                    "url": "https://download.swift.org/swift-5.10.1-release/amazonlinux2-aarch64/swift-5.10.1-RELEASE/swift-5.10.1-RELEASE-amazonlinux2-aarch64.tar.gz",
                    "sha256": "d5de792679ab9ba1336377ab941b7550ce0b9f5d0f65ee228b80e811de2f308b"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.Sdk.Extension.swift5.metainfo.xml"
                }
            ],
            "build-commands": [
                "mkdir -p /usr/lib/sdk/swift5",
                "cp -R usr/* /usr/lib/sdk/swift5",
                "install -Dm644 org.freedesktop.Sdk.Extension.swift5.metainfo.xml $FLATPAK_DEST/share/metainfo/org.freedesktop.Sdk.Extension.swift5.metainfo.xml"
            ]
        },
        {
	    "name": "SwiftLint",
	    "buildsystem": "simple",
	    "sources": [
		{
		    "type": "archive",
		    "url": "https://github.com/realm/SwiftLint/releases/download/0.55.1/swiftlint_linux.zip",
		    "sha256": "7a9ba94b35cd444f39f3d8b346958830a7da7bb4eee42a5fb2c153f5106bc7b4"
		}
	    ],
	    "build-commands": [
		"cp swiftlint /usr/lib/sdk/swift5/bin/"
	    ]
	},
        {
            "name": "swift-format",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/apple/swift-format/archive/refs/tags/510.1.0.tar.gz",
                    "sha256": "2174db6f721e66ddc95263239e4dd6112f81833bbf9cd4051cf9d3dca0f7b7fe"
                },
                {
                    "type": "git",
                    "url": "https://github.com/apple/swift-argument-parser.git",
                    "disable-shallow-clone": true,
                    "commit": "c8ed701b513cf5177118a175d85fbbbcd707ab41",
                    "dest": "swift-argument-parser"
                },
                {
                    "type": "git",
                    "url": "https://github.com/apple/swift-syntax.git",
                    "disable-shallow-clone": true,
                    "commit": "bdc3df2f5983fb29c0d36821552445e52965830b",
                    "dest": "swift-syntax"
                },
                {
                    "type": "git",
                    "url": "https://github.com/apple/swift-markdown.git",
                    "disable-shallow-clone": true,
                    "commit": "e4f95e2dc23097a1a9a1dfdfe3fe3ee44de77378",
                    "dest": "swift-markdown"
                },
                {
                    "type": "git",
                    "url": "https://github.com/apple/swift-cmark.git",
                    "disable-shallow-clone": true,
                    "commit": "f218e5d7691f78b55bfa39b367763f4612486c35",
                    "dest": "swift-cmark"
                },
                {
                    "type": "file",
                    "path": "swift-format-setup-offline.sh"
                }
            ],
            "build-commands": [
                "./swift-format-setup-offline.sh",
                "/usr/lib/sdk/swift5/bin/swift build -c release --skip-update",
                "strip -s .build/release/swift-format",
                "cp .build/release/swift-format /usr/lib/sdk/swift5/bin/"
            ]
        }
    ]
}
